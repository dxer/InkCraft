# ============================================================
# 墨匠 InkCraft —— 环境变量模板
# 复制本文件为 `.env.local` 并按需填写后使用：
#   cp .env.example .env.local
# ============================================================

# --- 访问门禁（可选）-----------------------------------------
# 设置后访问站点需先输入该口令通过登录页验证；留空则关闭密码门禁。
ACCESS_PASSWORD=

# --- 数据库路径（可选）-----------------------------------------
# 默认数据文件为 <项目根>/data/inkcraft.sqlite；可通过该变量重定向到任意路径。
# INKCRAFT_DB_PATH=/absolute/path/to/inkcraft.sqlite

# --- 大模型端点与密钥（可选，也可在 /settings 面板填写）---------
# 任何 OpenAI 兼容服务均可，例如 DeepSeek：
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat