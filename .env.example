# ============================================================
# 墨匠 InkCraft —— 环境变量模板
# 复制本文件为 `.env.local` 并按需填写后使用：
#   cp .env.example .env.local
# ============================================================

# --- 访问门禁（可选）-----------------------------------------
# 设置后访问站点需先输入该口令通过登录页验证；留空则关闭密码门禁。
ACCESS_PASSWORD=

# --- 数据库路径（可选）-----------------------------------------
# 默认数据文件为 <项目根>/data/inkcraft.sqlite；可通过该变量重定向到任意路径。
# INKCRAFT_DB_PATH=/absolute/path/to/inkcraft.sqlite

# ============================================================
# ⚠️ 注意事项：
# 大模型（LLM）端点与 API Key 不在配置文件/环境变量中配置！
# 启动项目后，请直接登录网页端进入「系统设置 (/settings)」页面：
#   - 支持可视化添加多个模型提供商（DeepSeek / OpenAI / SiliconFlow / 任意兼容端点）
#   - 支持多模型分类启用与文本/生图/嵌入三通道自由分配
#   - 设置数据安全保存在本地 SQLite 数据库中，热切换即时生效
# ============================================================
